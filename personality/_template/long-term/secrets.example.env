# 环境变量模板
# 复制为同目录下的 secrets.env 后填入真实值；secrets.env 不入库。
# 变量名与 long-term/capabilities.md 里各项能力的「密钥变量」一列一一对应。

# LLM 推理（兼容端点）
LLM_API_KEY=

# 降雨概率：分钟级与逐小时
QWEATHER_KEY=

# 通勤耗时与天气第二来源
AMAP_KEY=

# 语音外呼：叫醒
VOICE_CALL_KEY=

# 代下单
FOOD_API_KEY=

# IM 渠道：按最终选定的渠道填写对应凭据，其余留空
# 企业微信
IM_WECOM_SECRET=
# QQ 开放平台
IM_QQ_SECRET=
# 飞书
IM_FEISHU_SECRET=
